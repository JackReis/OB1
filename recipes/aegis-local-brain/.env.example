POSTGRES_DB=openbrain
POSTGRES_USER=openbrain_admin
POSTGRES_PASSWORD=generated-by-setup
POSTGREST_DB_PASSWORD=generated-by-setup
JWT_SECRET=generated-by-setup
SERVICE_ROLE_KEY=generated-by-setup
BRAIN_ACCESS_KEY=generated-by-setup

BRAIN_BIND_ADDR=127.0.0.1
BRAIN_API_PORT=8787

OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_EMBED_PATH=/api/embed
EMBED_MODEL=mxbai-embed-large
EMBED_DIM=1024
EMBED_PROVIDER=ollama
EMBED_VERSION=ollama:mxbai-embed-large:1024:v1
EMBED_NORMALIZE=0

# Additive rollout flags. Keep off until migration and shadow verification pass.
INGEST_V2_ENABLED=0
RETRIEVAL_V2_MODE=off
INGEST_ALLOWED_SOURCES=*
INGEST_RATE_LIMIT_PER_MINUTE=120
INGEST_MAX_CHUNKS=250
INGEST_CHUNK_MAX_CHARS=4000
